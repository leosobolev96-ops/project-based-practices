    "    ('macro_f1', 'Macro F1'),\n",
    "    ('log_loss', 'Log Loss'),\n",
    "    ('brier_score', 'Brier Score'),\n",
    "    ('ece', 'ECE'),\n",
    "]:\n",
    "    change = best[metric] - before[metric]\n",
    "    print(f\"{title}: {before[metric]:.4f} → {best[metric]:.4f} (Δ {change:+.4f})\")\n",
    "\n",
    "probability_metrics = ['log_loss', 'brier_score', 'ece']\n",
    "if all(best[metric] < before[metric] for metric in probability_metrics):\n",
    "    print('Вывод: посткалибровка улучшила качество вероятностей модели.')\n",
    "elif any(best[metric] < before[metric] for metric in probability_metrics):\n",
    "    print('Вывод: посткалибровка дала смешанный результат по вероятностным метрикам.')\n",
    "else:\n",
    "    print('Вывод: посткалибровка не улучшила качество вероятностей модели.')\n",
    "\n",
    "if best.accuracy == before.accuracy and best.macro_f1 == before.macro_f1:\n",
    "    print('Предсказанные классы не изменились: Accuracy и Macro F1 остались прежними.')\n",
    "else:\n",
    "    print('После калибровки изменились некоторые предсказанные классы.')"
   ]
  }
